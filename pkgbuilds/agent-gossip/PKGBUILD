# Maintainer: Caio Gondim <https://github.com/caiogondim>

pkgname=agent-gossip
pkgver=0.16.0
pkgrel=1
pkgdesc='Mesh network for agents'
arch=('x86_64' 'aarch64')
url='https://github.com/agent-habilis/agent-gossip'
license=('MIT')
depends=('glibc' 'libgcc')
# The AUR package installs the same files.
conflicts=('agent-gossip-bin')
# Upstream ships a stripped release build and no debug symbols to split out.
options=('!strip' '!debug')
# The release tarball holds the binary and the man pages, not the licence.
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/agent-habilis/agent-gossip/v${pkgver}/LICENSE")
source_x86_64=("${url}/releases/download/v${pkgver}/agent-gossip-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/agent-gossip-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums=('ae32188d5d37adc7e5f2ee97c506b4d342c7b4b567c75aed2022bfa92e5fcf60')
sha256sums_x86_64=('1631e5db7fe5f28ee14690e9e11233235f482af239574fb7ae95e3e9a9636999')
sha256sums_aarch64=('6adc7d4698bc4904aad012dead4d9ce95a3972e1004041f2dd8ef056494d568c')

package() {
  install -Dm755 agent-gossip "${pkgdir}/usr/bin/agent-gossip"
  install -Dm644 man/*.1 -t "${pkgdir}/usr/share/man/man1/"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
